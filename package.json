{
  "name": "paperflow",
  "version": "0.1.1",
  "private": true,
  "description": "面向科研论文的本地 PDF 阅读器",
  "main": "./out/main/index.js",
  "author": "PaperFlow contributors",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/prepare-pdf-assets.ts && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && tsx scripts/prepare-pdf-assets.ts && electron-vite build",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "pack:win": "pnpm build && electron-builder --win --x64 --dir --publish never",
    "dist:linux": "pnpm build && tsx scripts/dist-linux.ts",
    "dist:linux:deb": "pnpm dist:linux && tsx scripts/dist-linux-deb.ts",
    "postinstall": "install-electron",
    "rebuild:electron": "tsx scripts/verify-native.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/renderer/validation.ts"
  ]
}
